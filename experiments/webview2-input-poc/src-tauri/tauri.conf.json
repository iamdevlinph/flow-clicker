{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Trusted Input POC",
	"identifier": "com.flowclicker.webview2-input-poc",
	"build": {
		"frontendDist": "../src",
		"beforeDevCommand": "pnpm --dir ../.. build",
		"beforeBuildCommand": "pnpm --dir ../.. install --frozen-lockfile && pnpm --dir ../.. build"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "control",
				"title": "Trusted Input POC",
				"url": "index.html",
				"width": 760,
				"height": 900,
				"resizable": true,
				"center": true
			}
		],
		"security": { "csp": null }
	},
	"bundle": { "active": false }
}
