{
	"name": "flowclicker",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.15.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"type:check": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run",
		"check": "biome check",
		"fix": "biome check --fix",
		"prepare": "husky",
		"precommit": "lint-staged"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@types/node": "24.13.3",
		"husky": "9.1.7",
		"lint-staged": "17.3.0",
		"typescript": "7.0.2",
		"vitest": "2.1.0"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	}
}
