{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "FlowClicker",
	"identifier": "com.flowclicker.desktop",
	"build": {
		"frontendDist": "../src",
		"beforeDevCommand": "pnpm build",
		"beforeBuildCommand": "pnpm install --frozen-lockfile && pnpm build"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "FlowClicker",
				"url": "index.html",
				"backgroundColor": "#0b0e13",
				"width": 460,
				"height": 720,
				"resizable": false,
				"dragDropEnabled": false,
				"center": true
			},
			{
				"label": "overlay",
				"title": "FlowClicker Overlay",
				"url": "overlay.html",
				"width": 800,
				"height": 600,
				"visible": false,
				"decorations": false,
				"transparent": true,
				"alwaysOnTop": true,
				"skipTaskbar": true,
				"resizable": false,
				"shadow": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/icon.icns", "icons/icon.png"],
		"category": "Utility",
		"shortDescription": "Record and replay physical mouse click flows",
		"longDescription": "FlowClicker records click-only flows with delays and replays them through native OS mouse input."
	}
}
