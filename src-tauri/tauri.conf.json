{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowClicker",
  "version": "1.0.0",
  "identifier": "com.flowclicker.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FlowClicker",
        "url": "index.html",
        "width": 460,
        "height": 720,
        "resizable": false,
        "dragDropEnabled": false,
        "center": true
      },
      {
        "label": "editor",
        "title": "FlowClicker Editor",
        "url": "editor.html",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620,
        "visible": false,
        "resizable": true,
        "center": true
      },
      {
        "label": "overlay",
        "title": "FlowClicker Overlay",
        "url": "overlay.html",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Record and replay physical mouse click flows",
    "longDescription": "FlowClicker records click-only flows with delays and replays them through native OS mouse input."
  }
}
